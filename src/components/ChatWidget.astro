---
// ChatWidget.astro — 博客右下角小右聊天入口
---

<div id="xiaoyou-chat-root">
  <button id="xiaoyou-chat-toggle" class="chat-toggle" aria-label="聊天">
    <img src="/chat-flower.svg" alt="小右" width="72" height="72" />
  </button>

  <div id="xiaoyou-chat-panel" class="chat-panel hidden">
    <div class="chat-header">
      <div class="chat-header-info">
        <span class="chat-header-icon">🌬️</span>
        <div>
          <span class="chat-header-title">小右</span>
          <span class="chat-header-status">在线 · AI 助手</span>
        </div>
      </div>
      <button id="xiaoyou-chat-close" class="chat-close" aria-label="关闭">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div id="xiaoyou-chat-messages" class="chat-messages">
      <div class="message bot first">
        <div class="bubble">你好呀～我是小右，Yan 的数字助手。随便聊，别客气 🌬️</div>
      </div>
    </div>

    <div class="chat-input-area">
      <input
        type="text"
        id="xiaoyou-chat-input"
        class="chat-input"
        placeholder="说点什么..."
        maxlength="500"
        autocomplete="off"
      />
      <button id="xiaoyou-chat-send" class="chat-send" aria-label="发送">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const toggle = document.getElementById('xiaoyou-chat-toggle');
    const panel = document.getElementById('xiaoyou-chat-panel');
    const close = document.getElementById('xiaoyou-chat-close');
    const input = document.getElementById('xiaoyou-chat-input');
    const send = document.getElementById('xiaoyou-chat-send');
    const messages = document.getElementById('xiaoyou-chat-messages');
    const API_ENDPOINT = '/api/chat';
    const chatHistory = [];

    function addMessage(text, isUser) {
      const div = document.createElement('div');
      div.className = `message ${isUser ? 'user' : 'bot'}`;
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.textContent = text;
      div.appendChild(bubble);
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function showTyping() {
      const div = document.createElement('div');
      div.className = 'message bot typing';
      div.id = 'typing-indicator';
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
      div.appendChild(bubble);
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function hideTyping() {
      const el = document.getElementById('typing-indicator');
      if (el) el.remove();
    }

    async function sendMessage() {
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      addMessage(text, true);
      chatHistory.push({ role: 'user', content: text });
      showTyping();

      try {
        let reply;
        try {
          const res = await fetch(API_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text, history: chatHistory.slice(0, -1) })
          });
          const data = await res.json();
          reply = data.reply;
        } catch(e) {
          const replies = [
            "嗯哼，这个我得问问 Yan 才行 😅",
            "有意思！这部分我还在学习呢～",
            "好问题！等我连上 API 就能好好回答你啦",
            "让我想想……🤔"
          ];
          reply = replies[Math.floor(Math.random() * replies.length)];
        }
        hideTyping();
        addMessage(reply, false);
        chatHistory.push({ role: 'assistant', content: reply });
      } catch(e) {
        hideTyping();
        addMessage("哎呀出错了……稍后再试试？", false);
      }
    }

    toggle.addEventListener('click', () => {
      panel.classList.toggle('hidden');
      if (!panel.classList.contains('hidden')) {
        setTimeout(() => input.focus(), 100);
      }
    });

    close.addEventListener('click', () => {
      panel.classList.add('hidden');
    });

    send.addEventListener('click', sendMessage);

    // IME 修复：输入法组合中按 Enter 不发送
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.isComposing && e.keyCode !== 229) {
        e.preventDefault();
        sendMessage();
      }
    });

    // 点击外部关闭
    document.addEventListener('click', (e) => {
      if (!panel.classList.contains('hidden') &&
          !root.contains(e.target)) {
        panel.classList.add('hidden');
      }
    });
  })();
</script>

<style>
  #xiaoyou-chat-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  }

  /* ── 入口按钮 ── */
  .chat-toggle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.25s ease;
    box-shadow: 0 2px 12px rgba(0,0,0,0.10);
  }

  .chat-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 6px 28px rgba(0,0,0,0.18);
  }

  .chat-toggle img {
    width: 72px;
    height: 72px;
    display: block;
    border-radius: 50%;
  }

  /* ── 面板 ── */
  .chat-panel {
    position: absolute;
    bottom: 84px;
    right: 0;
    width: 340px;
    background: #F8F5F0;
    border-radius: 20px;
    box-shadow: 0 12px 48px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.06);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform-origin: bottom right;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .chat-panel.hidden {
    display: none;
  }

  /* ── 头部 ── */
  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 18px 14px;
    background: linear-gradient(135deg, #F8F5F0 0%, #F0ECDE 100%);
    border-bottom: 1px solid rgba(61,46,31,0.06);
  }

  .chat-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .chat-header-icon {
    font-size: 1.5em;
    line-height: 1;
  }

  .chat-header-title {
    display: block;
    font-size: 0.95em;
    font-weight: 600;
    color: #3D2E1F;
    letter-spacing: 0.02em;
  }

  .chat-header-status {
    display: block;
    font-size: 0.72em;
    color: #8A7A6A;
    margin-top: 1px;
  }

  .chat-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #8A7A6A;
    padding: 4px;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .chat-close:hover {
    background: rgba(0,0,0,0.05);
    color: #3D2E1F;
  }

  /* ── 消息区 ── */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px 16px 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 200px;
    max-height: 340px;
    scroll-behavior: smooth;
  }

  .chat-messages::-webkit-scrollbar {
    width: 4px;
  }

  .chat-messages::-webkit-scrollbar-track {
    background: transparent;
  }

  .chat-messages::-webkit-scrollbar-thumb {
    background: rgba(61,46,31,0.12);
    border-radius: 2px;
  }

  .message {
    display: flex;
    max-width: 88%;
    animation: msgIn 0.3s ease both;
  }

  @keyframes msgIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message.user {
    align-self: flex-end;
  }

  .bubble {
    padding: 10px 14px;
    font-size: 0.88em;
    line-height: 1.6;
    word-wrap: break-word;
    white-space: pre-wrap;
  }

  .message.bot .bubble {
    background: #FFFFFF;
    color: #3D2E1F;
    border-radius: 4px 16px 16px 16px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    border: 1px solid rgba(61,46,31,0.06);
  }

  .message.user .bubble {
    background: linear-gradient(135deg, #C8E68C 0%, #B5D87A 100%);
    color: #2A2A2A;
    border-radius: 16px 4px 16px 16px;
  }

  .message.first .bubble {
    border-top-left-radius: 16px;
  }

  /* ── 打字动画 ── */
  .typing .bubble {
    background: #FFFFFF;
    border-radius: 4px 16px 16px 16px;
    border: 1px solid rgba(61,46,31,0.06);
    padding: 14px 18px;
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #B5D87A;
    animation: dotPulse 1.4s infinite ease-in-out both;
  }

  .dot:nth-child(2) { animation-delay: 0.2s; }
  .dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes dotPulse {
    0%, 80%, 100% { opacity: 0.3; transform: scale(0.8); }
    40% { opacity: 1; transform: scale(1); }
  }

  /* ── 输入区 ── */
  .chat-input-area {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px 14px;
    background: #F8F5F0;
    border-top: 1px solid rgba(61,46,31,0.06);
  }

  .chat-input {
    flex: 1;
    border: 1px solid rgba(61,46,31,0.12);
    border-radius: 22px;
    padding: 9px 16px;
    font-size: 0.85em;
    outline: none;
    background: #FFFFFF;
    color: #3D2E1F;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
  }

  .chat-input::placeholder {
    color: #B0A090;
  }

  .chat-input:focus {
    border-color: #B5D87A;
    box-shadow: 0 0 0 3px rgba(181,216,122,0.15);
  }

  .chat-send {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: #B5D87A;
    color: #3D2E1F;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s, transform 0.15s;
    flex-shrink: 0;
  }

  .chat-send:hover {
    background: #A0C070;
    transform: scale(1.05);
  }

  .chat-send:active {
    transform: scale(0.95);
  }

  /* ── 暗色模式 ── */
  @media (prefers-color-scheme: dark) {
    .chat-panel {
      background: #252220;
      box-shadow: 0 12px 48px rgba(0,0,0,0.4);
    }
    .chat-header {
      background: linear-gradient(135deg, #2A2724 0%, #22201D 100%);
      border-bottom: 1px solid rgba(255,255,255,0.06);
    }
    .chat-header-title { color: #E0D8C8; }
    .chat-header-status { color: #8A7A6A; }
    .chat-close { color: #8A7A6A; }
    .chat-close:hover { background: rgba(255,255,255,0.06); color: #E0D8C8; }

    .message.bot .bubble {
      background: #33302C;
      color: #E0D8C8;
      border-color: rgba(255,255,255,0.06);
    }
    .message.user .bubble {
      background: linear-gradient(135deg, #4A6A30 0%, #3D5A20 100%);
      color: #E0D8C8;
    }
    .typing .bubble {
      background: #33302C;
      border-color: rgba(255,255,255,0.06);
    }
    .dot { background: #7A9A50; }

    .chat-input-area {
      background: #252220;
      border-top-color: rgba(255,255,255,0.06);
    }
    .chat-input {
      background: #33302C;
      border-color: rgba(255,255,255,0.1);
      color: #E0D8C8;
    }
    .chat-input::placeholder { color: #6A6050; }
    .chat-input:focus {
      border-color: #7A9A50;
      box-shadow: 0 0 0 3px rgba(122,154,80,0.15);
    }
    .chat-send {
      background: #5A7A40;
      color: #E0D8C8;
    }
    .chat-send:hover { background: #4A6A30; }
  }
</style>
