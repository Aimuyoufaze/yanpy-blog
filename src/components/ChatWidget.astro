---
// ChatWidget.astro — 博客右下角聊天小右入口组件
// 用 client:only 让它在浏览器侧运行
---

<div id="xiaoyou-chat-root">
  <!-- 入口按钮 -->
  <button id="xiaoyou-chat-toggle" class="chat-toggle" aria-label="聊天">
    <img src="/chat-flower.svg" alt="小右" width="40" height="40" />
  </button>

  <!-- 聊天窗口 -->
  <div id="xiaoyou-chat-panel" class="chat-panel hidden">
    <div class="chat-header">
      <span class="chat-header-title">🌬️ 小右</span>
      <button id="xiaoyou-chat-close" class="chat-close" aria-label="关闭">✕</button>
    </div>
    <div id="xiaoyou-chat-messages" class="chat-messages">
      <div class="message bot">
        <span class="avatar">🌬️</span>
        <div class="bubble">你好！我是小右，Yan 的数字助手。有什么想问的尽管说～</div>
      </div>
    </div>
    <div class="chat-input-area">
      <input
        type="text"
        id="xiaoyou-chat-input"
        class="chat-input"
        placeholder="问小右点什么..."
        maxlength="500"
      />
      <button id="xiaoyou-chat-send" class="chat-send" aria-label="发送">➤</button>
    </div>
  </div>
</div>

<script>
  (function() {
    const root = document.getElementById('xiaoyou-chat-root');
    const toggle = document.getElementById('xiaoyou-chat-toggle');
    const panel = document.getElementById('xiaoyou-chat-panel');
    const close = document.getElementById('xiaoyou-chat-close');
    const input = document.getElementById('xiaoyou-chat-input');
    const send = document.getElementById('xiaoyou-chat-send');
    const messages = document.getElementById('xiaoyou-chat-messages');
    const API_ENDPOINT = '/api/chat';
    const chatHistory = [];  // 保存对话历史

    function addMessage(text, isUser) {
      const div = document.createElement('div');
      div.className = `message ${isUser ? 'user' : 'bot'}`;
      if (!isUser) {
        const avatar = document.createElement('span');
        avatar.className = 'avatar';
        avatar.textContent = '🌬️';
        div.appendChild(avatar);
      }
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.textContent = text;
      div.appendChild(bubble);
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function showTyping() {
      const div = document.createElement('div');
      div.className = 'message bot typing';
      div.id = 'typing-indicator';
      const avatar = document.createElement('span');
      avatar.className = 'avatar';
      avatar.textContent = '🌬️';
      div.appendChild(avatar);
      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.innerHTML = '<span class="dot">.</span><span class="dot">.</span><span class="dot">.</span>';
      div.appendChild(bubble);
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function hideTyping() {
      const el = document.getElementById('typing-indicator');
      if (el) el.remove();
    }

    async function sendMessage() {
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      addMessage(text, true);
      chatHistory.push({ role: 'user', content: text });
      showTyping();

      try {
        let reply;
        try {
          const res = await fetch(API_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text, history: chatHistory.slice(0, -1) })
          });
          const data = await res.json();
          reply = data.reply;
        } catch(e) {
          const echoReplies = [
            "嗯，这个我得问问 Yan 才行 😅",
            "有意思！不过这部分我还在学习中～",
            "好问题！等 Yan 把我的 API 接上我就能好好回答你了！",
            "这个嘛……让我想想 🤔"
          ];
          reply = echoReplies[Math.floor(Math.random() * echoReplies.length)];
        }
        hideTyping();
        addMessage(reply, false);
        chatHistory.push({ role: 'assistant', content: reply });
      } catch(e) {
        hideTyping();
        addMessage("哎呀，出错了……稍后再试试？", false);
      }
    }

    toggle.addEventListener('click', () => {
      panel.classList.toggle('hidden');
      if (!panel.classList.contains('hidden')) {
        input.focus();
      }
    });

    close.addEventListener('click', () => {
      panel.classList.add('hidden');
    });

    send.addEventListener('click', sendMessage);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendMessage();
    });
  })();
</script>

<style>
  #xiaoyou-chat-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .chat-toggle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    padding: 0;
    box-shadow: 0 2px 12px rgba(0,0,0,0.12);
  }

  .chat-toggle:hover {
    transform: scale(1.1);
    box-shadow: 0 4px 20px rgba(0,0,0,0.18);
  }

  .chat-toggle img {
    width: 56px;
    height: 56px;
    display: block;
    border-radius: 50%;
  }

  .chat-panel {
    position: absolute;
    bottom: 68px;
    right: 0;
    width: 340px;
    max-height: 480px;
    background: #FAF6EE;
    border-radius: 16px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .chat-panel.hidden {
    display: none;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px;
    background: #C8E68C;
    color: #2a2a2a;
    font-weight: 600;
    font-size: 0.95em;
  }

  .chat-close {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.1em;
    color: #5a5a5a;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .chat-close:hover {
    background: rgba(0,0,0,0.1);
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 200px;
    max-height: 340px;
  }

  .message {
    display: flex;
    gap: 8px;
    max-width: 85%;
  }

  .message.user {
    align-self: flex-end;
    flex-direction: row-reverse;
  }

  .avatar {
    flex-shrink: 0;
    font-size: 1.2em;
    margin-top: 2px;
  }

  .bubble {
    padding: 8px 12px;
    border-radius: 12px;
    font-size: 0.88em;
    line-height: 1.5;
    word-wrap: break-word;
  }

  .message.bot .bubble {
    background: #e8e4da;
    color: #333;
    border-bottom-left-radius: 4px;
  }

  .message.user .bubble {
    background: #B5D87A;
    color: #2a2a2a;
    border-bottom-right-radius: 4px;
  }

  .typing .bubble {
    background: #e8e4da;
  }

  .dot {
    animation: blink 1.4s infinite;
    font-weight: bold;
    font-size: 1.2em;
    line-height: 0;
  }
  .dot:nth-child(2) { animation-delay: 0.2s; }
  .dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes blink {
    0%, 80%, 100% { opacity: 0; }
    40% { opacity: 1; }
  }

  .chat-input-area {
    display: flex;
    border-top: 1px solid rgba(0,0,0,0.08);
    padding: 10px;
    gap: 6px;
    background: #f5f1e8;
  }

  .chat-input {
    flex: 1;
    border: 1px solid #ddd;
    border-radius: 20px;
    padding: 8px 14px;
    font-size: 0.88em;
    outline: none;
    background: white;
  }

  .chat-input:focus {
    border-color: #B5D87A;
  }

  .chat-send {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: none;
    background: #B5D87A;
    color: #333;
    cursor: pointer;
    font-size: 1em;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .chat-send:hover {
    background: #A0C070;
  }

  /* Dark mode */
  @media (prefers-color-scheme: dark) {
    .chat-panel {
      background: #2a2a2a;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    .chat-header {
      background: #4a6a30;
      color: #eee;
    }
    .message.bot .bubble {
      background: #3a3a3a;
      color: #ddd;
    }
    .message.user .bubble {
      background: #5a7a40;
      color: #eee;
    }
    .chat-input {
      background: #333;
      border-color: #555;
      color: #ddd;
    }
    .chat-input:focus {
      border-color: #7a9a50;
    }
    .chat-input-area {
      background: #2a2a2a;
      border-top-color: rgba(255,255,255,0.1);
    }
  }
</style>
