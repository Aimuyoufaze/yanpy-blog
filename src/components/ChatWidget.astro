---
// ChatWidget.astro — 手绘风小右聊天入口
---

<div id="xiaoyou-chat-root">
  <button id="xiaoyou-chat-toggle" class="chat-toggle" aria-label="聊天">
    <img src="/grass.png" alt="小右" width="72" height="72" />
  </button>

  <div id="xiaoyou-chat-panel" class="chat-panel hidden">
    <div class="chat-header">
      <div class="chat-header-info">
        <span class="chat-header-icon">🌬️</span>
        <div>
          <span class="chat-header-title">小右</span>
          <span class="chat-header-status">在线 · AI 助手</span>
        </div>
      </div>
      <button id="xiaoyou-chat-close" class="chat-close" aria-label="关闭">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div id="xiaoyou-chat-messages" class="chat-messages">
      <div class="message bot first">
        <span class="msg-avatar">🌬️</span>
        <div class="bubble">你好呀～我是小右，Yan 的数字助手 🌬️</div>
      </div>
    </div>

    <div class="chat-input-area">
      <input
        type="text"
        id="xiaoyou-chat-input"
        class="chat-input"
        placeholder="说点什么……"
        maxlength="500"
        autocomplete="off"
      />
      <button id="xiaoyou-chat-send" class="chat-send" aria-label="发送">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
        </svg>
      </button>
    </div>
  </div>
</div>

<script>
  (function() {
    const root = document.getElementById('xiaoyou-chat-root');
    const toggle = document.getElementById('xiaoyou-chat-toggle');
    const panel = document.getElementById('xiaoyou-chat-panel');
    const close = document.getElementById('xiaoyou-chat-close');
    const input = document.getElementById('xiaoyou-chat-input');
    const send = document.getElementById('xiaoyou-chat-send');
    const messages = document.getElementById('xiaoyou-chat-messages');
    const API_ENDPOINT = '/api/chat';
    const chatHistory = [];

    function addMessage(text, isUser) {
      const div = document.createElement('div');
      div.className = `message ${isUser ? 'user' : 'bot'}`;

      if (!isUser) {
        const avatar = document.createElement('span');
        avatar.className = 'msg-avatar';
        avatar.textContent = '🌬️';
        div.appendChild(avatar);
      }

      const wrap = document.createElement('div');
      wrap.className = 'msg-wrap';

      const bubble = document.createElement('div');
      bubble.className = 'bubble';
      bubble.textContent = text;
      wrap.appendChild(bubble);

      if (!isUser) {
        const tag = document.createElement('span');
        tag.className = 'msg-tag msg-tag-bot';
        tag.textContent = '小右';
        wrap.appendChild(tag);
      } else {
        const tag = document.createElement('span');
        tag.className = 'msg-tag msg-tag-user';
        tag.textContent = '你';
        wrap.appendChild(tag);
      }

      div.appendChild(wrap);
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function showTyping() {
      const div = document.createElement('div');
      div.className = 'message bot';
      div.id = 'typing-wrap';
      const avatar = document.createElement('span');
      avatar.className = 'msg-avatar';
      avatar.textContent = '🌬️';
      div.appendChild(avatar);
      const wrap = document.createElement('div');
      wrap.className = 'msg-wrap';
      const bubble = document.createElement('div');
      bubble.className = 'bubble typing-bubble';
      bubble.innerHTML = '<span class="dot"></span><span class="dot"></span><span class="dot"></span>';
      wrap.appendChild(bubble);
      div.appendChild(wrap);
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function hideTyping() {
      const el = document.getElementById('typing-wrap');
      if (el) el.remove();
    }

    async function sendMessage() {
      const text = input.value.trim();
      if (!text) return;
      input.value = '';
      addMessage(text, true);
      chatHistory.push({ role: 'user', content: text });
      showTyping();

      try {
        let reply;
        try {
          const res = await fetch(API_ENDPOINT, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text, history: chatHistory.slice(0, -1) })
          });
          const data = await res.json();
          reply = data.reply;
        } catch(e) {
          const replies = [
            "嗯哼，这个我得问问 Yan 才行 😅",
            "有意思！等我连上 API 就能好好回答你啦",
            "好问题！不过这部分我还在学习呢～",
            "让我想想……🤔"
          ];
          reply = replies[Math.floor(Math.random() * replies.length)];
        }
        hideTyping();
        addMessage(reply, false);
        chatHistory.push({ role: 'assistant', content: reply });
      } catch(e) {
        hideTyping();
        addMessage("哎呀出错了……稍后再试试？", false);
      }
    }

    toggle.addEventListener('click', () => {
      panel.classList.toggle('hidden');
      if (!panel.classList.contains('hidden')) {
        setTimeout(() => input.focus(), 100);
      }
    });

    close.addEventListener('click', () => {
      panel.classList.add('hidden');
    });

    send.addEventListener('click', sendMessage);

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.isComposing && e.keyCode !== 229) {
        e.preventDefault();
        sendMessage();
      }
    });

    document.addEventListener('click', (e) => {
      if (!panel.classList.contains('hidden') &&
          !root.contains(e.target)) {
        panel.classList.add('hidden');
      }
    });
  })();
</script>

<style is:global>
  #xiaoyou-chat-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', 'Noto Sans SC', sans-serif;
  }

  /* ══════ 入口按钮 ══════ */
  .chat-toggle {
    width: 72px; height: 72px;
    border-radius: 50%;
    border: 2px solid #3D2E1F;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2px;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1),
                box-shadow 0.25s ease;
    box-shadow: 4px 4px 0 #5A7A30;
  }
  .chat-toggle:hover {
    transform: scale(1.08);
    box-shadow: 5px 5px 0 #5A7A30;
  }
  .chat-toggle img {
    width: 100%; height: 100%;
    display: block;
    border-radius: 50%;
    object-fit: cover;
  }

  /* ══════ 主面板 ══════ */
  .chat-panel {
    position: absolute;
    bottom: 84px;
    right: 0;
    width: 340px;
    min-width: 280px;
    max-width: 520px;
    min-height: 360px;
    max-height: 640px;
    background: #F5F0E6;
    border-radius: 18px;
    border: 1.5px solid #3D2E1F;
    box-shadow: 6px 6px 0 rgba(61,46,31,0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    resize: both;
    transition: opacity 0.2s ease;
  }
  .chat-panel.hidden { display: none; }

  /* ══════ 头部 ══════ */
  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 16px 12px;
    background: #EDE6D6;
    border-bottom: 1.5px solid #3D2E1F;
  }
  .chat-header-info {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .chat-header-icon { font-size: 1.5em; line-height: 1; }
  .chat-header-title {
    display: block;
    font-size: 0.95em;
    font-weight: 700;
    color: #3D2E1F;
    letter-spacing: 0.02em;
  }
  .chat-header-status {
    display: block;
    font-size: 0.7em;
    color: #7A6A5A;
    margin-top: 1px;
  }
  .chat-close {
    background: none;
    border: 1.5px solid #3D2E1F;
    cursor: pointer;
    color: #3D2E1F;
    padding: 5px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s;
  }
  .chat-close:hover { background: rgba(61,46,31,0.06); }

  /* ══════ 消息区 ══════ */
  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px 14px 8px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 100px;
  }
  .chat-messages::-webkit-scrollbar { width: 4px; }
  .chat-messages::-webkit-scrollbar-track { background: transparent; }
  .chat-messages::-webkit-scrollbar-thumb {
    background: rgba(61,46,31,0.12);
    border-radius: 2px;
  }

  .message {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    max-width: 88%;
    animation: msgIn 0.25s ease both;
  }
  @keyframes msgIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .message.user { align-self: flex-end; flex-direction: row-reverse; }
  .message.bot { align-self: flex-start; }

  .msg-avatar {
    flex-shrink: 0;
    width: 28px; height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #EDE6D6;
    border: 1.5px solid #3D2E1F;
    border-radius: 50%;
    font-size: 13px;
    margin-top: 4px;
  }

  .msg-wrap {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .message.user .msg-wrap { align-items: flex-end; }

  .bubble {
    padding: 9px 13px;
    font-size: 0.88em;
    line-height: 1.6;
    word-wrap: break-word;
    white-space: pre-wrap;
  }

  /* ── 小右气泡：卡其底 + 深绿阴影 ── */
  .message.bot .bubble {
    background: #F0ECDE;
    color: #3D2E1F;
    border: 1.5px solid #3D2E1F;
    border-radius: 4px 14px 14px 14px;
    box-shadow: 4px 4px 0 #5A7A30;
  }

  /* ── 用户气泡：卡其底 + 深红阴影 ── */
  .message.user .bubble {
    background: #F0ECDE;
    color: #3D2E1F;
    border: 1.5px solid #3D2E1F;
    border-radius: 14px 4px 14px 14px;
    box-shadow: -4px 4px 0 #8B3A3A;
  }

  .msg-tag {
    font-size: 0.65em;
    padding: 0 4px;
    letter-spacing: 0.04em;
  }
  .msg-tag-bot { color: #5A7A30; }
  .msg-tag-user { color: #8B3A3A; }

  .message.first .bubble { border-top-left-radius: 14px; }

  /* ── 打字动画 ── */
  .typing-bubble {
    display: flex;
    gap: 5px;
    align-items: center;
    padding: 12px 18px !important;
    border-radius: 4px 14px 14px 14px !important;
  }
  .dot {
    display: inline-block;
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #5A7A30;
    animation: dotPulse 1.4s infinite ease-in-out both;
  }
  .dot:nth-child(2) { animation-delay: 0.2s; }
  .dot:nth-child(3) { animation-delay: 0.4s; }
  @keyframes dotPulse {
    0%, 80%, 100% { opacity: 0.25; transform: scale(0.8); }
    40% { opacity: 1; transform: scale(1); }
  }

  /* ══════ 输入区 ══════ */
  .chat-input-area {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px 12px;
    background: #F5F0E6;
    border-top: 1.5px solid #3D2E1F;
  }
  .chat-input {
    flex: 1;
    border: 1.5px solid #3D2E1F;
    border-radius: 20px;
    padding: 8px 14px;
    font-size: 0.85em;
    outline: none;
    background: #FAF6EE;
    color: #3D2E1F;
    font-family: inherit;
    transition: box-shadow 0.2s;
  }
  .chat-input::placeholder { color: #B0A090; }
  .chat-input:focus {
    box-shadow: 3px 3px 0 rgba(61,46,31,0.08);
  }

  .chat-send {
    width: 36px; height: 36px;
    border-radius: 50%;
    border: 1.5px solid #3D2E1F;
    background: #FAF6EE;
    color: #3D2E1F;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, transform 0.15s;
    flex-shrink: 0;
    box-shadow: 2px 2px 0 rgba(61,46,31,0.1);
  }
  .chat-send:hover {
    background: #EDE6D6;
    transform: scale(1.05);
  }
  .chat-send:active { transform: scale(0.95); }

  /* ══════ 暗色模式 ══════ */
  @media (prefers-color-scheme: dark) {
    .chat-panel {
      background: #2A2722;
      border-color: #6A6050;
      box-shadow: 6px 6px 0 rgba(0,0,0,0.3);
      resize: both;
    }
    .chat-header {
      background: #25221E;
      border-bottom-color: #6A6050;
    }
    .chat-header-title { color: #E0D8C8; }
    .chat-header-status { color: #8A7A6A; }
    .chat-close {
      border-color: #6A6050;
      color: #E0D8C8;
    }
    .chat-close:hover { background: rgba(255,255,255,0.05); }

    .msg-avatar {
      background: #33302C;
      border-color: #6A6050;
    }

    .message.bot .bubble {
      background: #33302C;
      color: #E0D8C8;
      border-color: #6A6050;
      box-shadow: 4px 4px 0 #4A6A30;
    }
    .message.user .bubble {
      background: #33302C;
      color: #E0D8C8;
      border-color: #6A6050;
      box-shadow: -4px 4px 0 #6A3030;
    }
    .msg-tag-bot { color: #7A9A50; }
    .msg-tag-user { color: #A05050; }

    .dot { background: #7A9A50; }

    .chat-input-area {
      background: #2A2722;
      border-top-color: #6A6050;
    }
    .chat-input {
      background: #33302C;
      border-color: #6A6050;
      color: #E0D8C8;
    }
    .chat-input::placeholder { color: #6A6050; }
    .chat-send {
      background: #33302C;
      border-color: #6A6050;
      color: #E0D8C8;
      box-shadow: 2px 2px 0 rgba(0,0,0,0.2);
    }
    .chat-send:hover { background: #3D3A36; }
  }
</style>
