---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<div class="intro-content">
					<div class="intro-text">
						<h1>Hi, I'm Yan 👋</h1>
						<p>
							Information Management & System 专业在读，喜欢捣鼓 AI、写代码、打篮球和羽毛球。
						</p>
						<p>这里会写一些关于技术、学习和日常的东西。</p>
					</div>
					<video class="intro-video" src="/intro.mp4?v=2" autoplay muted playsinline preload="auto"></video>
				</div>
			</section>

			<hr />

			<section class="recent-posts">
				<h2>Recent Posts</h2>
				{
					posts.length > 0 ? (
						<ul>
							{
								posts.map((post) => (
									<li>
										<a href={`/blog/${post.id}/`}>
											<h3>{post.data.title}</h3>
											<p class="meta">
												<FormattedDate date={post.data.pubDate} />
											</p>
											{post.data.description && <p class="desc">{post.data.description}</p>}
										</a>
									</li>
								))
							}
						</ul>
					) : (
						<p class="empty">No posts yet. Coming soon!</p>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.intro {
		margin-bottom: 2em;
	}
	.intro-content {
		display: flex;
		align-items: center;
		gap: 2em;
	}
	.intro h1 {
		margin-bottom: 0.5em;
		font-size: 2.2em;
	}
	.intro p {
		color: var(--text-secondary);
		font-size: 1.1em;
		max-width: 540px;
	}
	.intro-video {
		width: 140px;
		height: 140px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
		box-shadow: 0 2px 8px rgba(0,0,0,0.08);
	}
	@media (max-width: 640px) {
		.intro-content {
			flex-direction: column-reverse;
			text-align: center;
		}
		.intro p {
			max-width: 100%;
		}
		.intro-video {
			width: 120px;
			height: 120px;
		}
	}

	.recent-posts h2 {
		font-size: 1.4em;
		margin-bottom: 1em;
	}

	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5em;
	}

	ul li a {
		display: block;
		padding: 1.25em 1.5em;
		background: var(--bg-card);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	ul li a:hover {
		background: var(--bg-hover);
		border-color: var(--accent);
	}

	ul li h3 {
		margin: 0 0 0.3em 0;
		font-size: 1.15em;
		color: var(--text-primary);
	}

	.meta {
		margin: 0 0 0.4em 0;
		font-size: 0.85em;
		color: var(--text-secondary);
	}

	.desc {
		margin: 0;
		font-size: 0.95em;
		color: var(--text-secondary);
		line-height: 1.5;
	}

	.empty {
		color: var(--text-secondary);
		font-style: italic;
	}

	@media (max-width: 720px) {
		.intro h1 {
			font-size: 1.8em;
		}
		ul li a {
			padding: 1em;
		}
	}
</style>
